GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST/DB_NAME"

NEXTAUTH_SECRET=

LAST_FM_API_KEY=
LAST_FM_API_SECRET=

DASHBOARD_PASSWORD=

# Sentry Configuration
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Stripe: billing for all new subscriptions
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET="" // signing secret of the /api/webhooks/stripe endpoint
STRIPE_PRODUCT_ID="" // Pro plan product; its default price is what gets charged
STRIPE_PRICE_ID="" // optional: pin a specific price instead of the product default
STRIPE_MANAGED_PAYMENTS="false" // "true" = Stripe is merchant of record (needs an eligible account)
# Paddle: only for subscriptions bought before the move to Stripe
NEXT_PUBLIC_PADDLE_ENV="sandbox" // sandbox or production
PADDLE_API_KEY=""
PADDLE_NOTIFICATION_WEBHOOK_SECRET=""
RESEND_API_KEY=""

# Support email agent (inbound webhook: /api/webhooks/inbound-email)
RESEND_WEBHOOK_SECRET=""        # signing secret of the Resend `email.received` webhook
ANTHROPIC_API_KEY=""
SUPPORT_FROM="Bocono Labs Support <support@bocono-labs.com>"
SUPPORT_ESCALATION_EMAIL=""     # where escalations are forwarded and replies are BCC'd
SUPPORT_OWN_DOMAINS="bocono-labs.com"  # never auto-reply to these (loop protection)
# optional: SUPPORT_AGENT_MODEL, SUPPORT_TOKEN_SECRET (defaults to NEXTAUTH_SECRET), APP_URL
